{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],

  /*
   * `vue-tsc -b` builds the two referenced projects and ignores what is here,
   * because `files` is empty. Vercel is the reason this block exists: it does
   * NOT support project references, so when it typechecks `api/index.ts` and
   * everything reachable from it, tsconfig.node.json is invisible and only
   * this file is read.
   *
   * These must stay in step with tsconfig.node.json, and in particular must
   * stay on nodenext. An earlier version set "bundler" here to silence TS2835
   * on extensionless relative imports. That was the wrong fix: the compiler
   * was right. package.json declares `"type": "module"`, so the JavaScript
   * Vercel emits is ESM, and Node ESM cannot resolve an extensionless relative
   * import. The build went green and every API route then failed at runtime
   * with ERR_MODULE_NOT_FOUND, which surfaces only as
   * FUNCTION_INVOCATION_FAILED.
   */
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
